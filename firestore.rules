rules_version = '2';

// Reglas de seguridad de Firestore para "Ventas & GP Coins".
// Modelo: cada agente tiene su documento privado en usuarios/{uid}.
// El admin (correo en la lista) puede LEER todos los documentos pero
// cada usuario solo puede ESCRIBIR el suyo.
service cloud.firestore {
  match /databases/{database}/documents {

    // Lista de correos con permisos de administrador (supervisor)
    function esAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['jhussepy08@gmail.com'];
    }

    match /usuarios/{uid} {
      // Lectura: el propio usuario o un administrador
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      // Escritura: solo el propio usuario sobre su documento
      allow write: if request.auth != null && request.auth.uid == uid;

      // Esquema v2: registros independientes. Solo se habilitan las colecciones
      // conocidas para no abrir cualquier ruta bajo el documento del usuario.
      match /{coleccion}/{documento} {
        allow read: if coleccion in ['ventasVodafone', 'ventasLowi', 'agendados'] &&
          request.auth != null && (request.auth.uid == uid || esAdmin());
        allow write: if coleccion in ['ventasVodafone', 'ventasLowi', 'agendados'] &&
          request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
