rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function propietario(uid) {
      return request.auth != null && request.auth.uid == uid &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'jhussepy08@gmail.com';
    }
    match /usuarios/{uid} {
      allow read, write: if propietario(uid);
      match /{coleccion}/{documento} {
        allow read, write: if propietario(uid) &&
          coleccion in ['ventasVodafone', 'ventasLowi', 'agendados'];
      }
    }
  }
}
